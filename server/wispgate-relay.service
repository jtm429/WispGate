[Unit]
Description=WispGate relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wisp
Group=wisp
WorkingDirectory=/opt/wispgate/server
ExecStart=/opt/wispgate/.venv/bin/python -m appserve_server --private-key /var/lib/wispgate/server-key.pem --state /var/lib/wispgate/state.json --deployment-id private --control-host 0.0.0.0 --control-port 443 --relay-host 0.0.0.0 --relay-port 4443 --update-command /usr/bin/sudo -n /usr/local/sbin/wispgate-update
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wispgate

[Install]
WantedBy=multi-user.target
